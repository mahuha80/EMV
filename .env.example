# ========================
# JIRA MCP Configuration
# ========================
JIRA_MCP_URL=https://your-company.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=PROJ

# ========================
# Appium Configuration
# ========================
APPIUM_SERVER_URL=http://localhost:4723

# Android
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=13.0
ANDROID_APP_PACKAGE=com.your.app
ANDROID_APP_ACTIVITY=.MainActivity
ANDROID_APP_PATH=/path/to/your/app.apk

# iOS
IOS_DEVICE_UDID=your_ios_device_udid
IOS_PLATFORM_VERSION=17.0
IOS_BUNDLE_ID=com.your.app
IOS_APP_PATH=/path/to/your/app.ipa

# ========================
# GitHub Configuration
# ========================
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=owner/repository-name
GITHUB_BASE_BRANCH=main
GITHUB_REVIEWERS=reviewer1,reviewer2

# ========================
# AI Configuration
# ========================
# Options: openai | anthropic
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o
AI_MAX_TOKENS=4096
AI_CONFIDENCE_THRESHOLD=0.7

# ========================
# Pipeline Configuration
# ========================
DEFAULT_PLATFORM=android
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=5
LOG_LEVEL=INFO
REPORTS_BASE_DIR=reports

